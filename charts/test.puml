@startwbs
<style>
' Ownership colours
.milan {
  BackgroundColor #ffaa77;
}
.charlie {
  BackgroundColor #bbeeff;
}
.jack {
  BackgroundColor #ffffff;
}
.lisa {
  BackgroundColor #f7fc51;
}

' Shared ownership colours
.milan_charlie {
  BackgroundColor #ffaa77/#bbeeff;
}
.milan_jack {
  BackgroundColor #ffaa77/#ffffff;
}
.milan_lisa {
  BackgroundColor #ffaa77/#f7fc51;
}
.charlie_jack {
  BackgroundColor #bbeeff/#ffffff;
}
.charlie_lisa {
  BackgroundColor #bbeeff/#f7fc51;
}
.jack_lisa {
  BackgroundColor #ffffff/#f7fc51;
}

